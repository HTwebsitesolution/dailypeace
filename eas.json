{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "internal": {
      "distribution": "internal",
      "channel": "internal"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://dailypeace.life/.netlify/functions",
        "EXPO_PUBLIC_APP_LINK": "https://dailypeace.life"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "en-US"
      }
    }
  }
}
