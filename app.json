{
  "expo": {
    "name": "Daily Peace",
    "slug": "daily-peace",
    "scheme": "dailypeace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icons/icon-ios.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1016",
    "primaryColor": "#3B82F6",
    "description": "Find peace and hope from Scripture. Daily Peace offers AI-powered spiritual guidance, curated Bible verse collections, and personalized reflections to bring calm and purpose to your daily life.",
    "splash": {
      "image": "./assets/branding/splash/splash-dailypeace.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1016"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "life.dailypeace.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Daily Peace uses your microphone to transcribe voice prayers and reflections.",
        "NSSpeechRecognitionUsageDescription": "Daily Peace uses speech recognition to understand your spoken prayers.",
        "UIBackgroundModes": ["audio"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "life.dailypeace.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icons/icon-android.png",
        "backgroundColor": "#0B1016"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/branding/icons/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/icons/icon-ios.png",
          "color": "#2F80ED",
          "mode": "production"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "7110355b-7f81-4095-9927-1cb9680a0efa"
      },
      "SENTRY_DSN": "REPLACE_WITH_SENTRY_DSN",
      "POSTHOG_KEY": "REPLACE_WITH_POSTHOG_KEY",
      "POSTHOG_HOST": "https://app.posthog.com"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "owner": "htweb",
    "privacy": "public",
    "githubUrl": "https://github.com/HTwebsitesolution/dailypeace"
  }
}
